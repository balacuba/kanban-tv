# Tài khoản để trang thử TỰ LẤY TOKEN (Keycloak, grant_type=password).
# Cách dùng: chép file này thành ".env.token" (cùng thư mục), điền 3 dòng còn trống rồi lưu.
# Server thử sẽ tự lấy token ngay và tự gia hạn trước khi hết hạn; trình duyệt không thấy mật khẩu hay token.
# KHÔNG đưa các giá trị này vào code giao diện (HourlyOutputReport.tsx) và không gửi file .env.token cho người khác.

KC_TOKEN_URL=http://14.241.68.10:8800/auth/realms/QLSX/protocol/openid-connect/token
KC_CLIENT_ID=planning_backend
KC_CLIENT_SECRET=
KC_USERNAME=
KC_PASSWORD=
